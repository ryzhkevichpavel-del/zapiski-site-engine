# Optional public URL used when rendering absolute links.
TUONELA_PUBLIC_BASE_URL=http://127.0.0.1:8765

# Optional bridge to a private back-office service.
# Leave empty when running the public site kit by itself.
TREBNIK_BRIDGE_URL=http://127.0.0.1:8787
TREBNIK_BRIDGE_TOKEN=
TREBNIK_BRIDGE_TIMEOUT_SECONDS=8
